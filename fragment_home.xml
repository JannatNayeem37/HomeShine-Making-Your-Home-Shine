<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="20dp"
            android:gravity="center_vertical">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HomeShine" android:textColor="@color/teal_dark" android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📍 Dhanmondi, Dhaka" android:textColor="@color/gray_text" android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnNotif"
                android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center" android:text="🔔" android:textSize="18sp"/>
        </LinearLayout>

        <!-- Search -->
        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:hint="Search a service (e.g. sofa)"
            android:textSize="14sp" android:imeOptions="actionSearch"
            android:singleLine="true"/>

        <!-- Before/After hero card -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="20dp"
            android:background="@drawable/bg_rounded_card"
            android:elevation="2dp">

            <FrameLayout
                android:id="@+id/sliderFrame"
                android:layout_width="match_parent" android:layout_height="220dp">

                <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/img_before_cleaning"/>

                <FrameLayout
                    android:id="@+id/afterPanel"
                    android:layout_width="180dp" android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:background="@drawable/img_after_cleaning"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start" android:layout_margin="12dp"
                    android:text="BEFORE" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp"
                    android:background="#66000000" android:paddingHorizontal="8dp" android:paddingVertical="4dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end" android:layout_margin="12dp"
                    android:text="AFTER" android:textColor="@color/white" android:textStyle="bold" android:textSize="11sp"
                    android:background="#66000000" android:paddingHorizontal="8dp" android:paddingVertical="4dp"/>

                <SeekBar
                    android:id="@+id/beforeAfterSeek"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:progressDrawable="@null"
                    android:thumb="@drawable/slider_thumb"
                    android:max="100"
                    android:progress="45"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Your home," android:textColor="@color/ink" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="spotless again" android:textColor="@color/teal_dark" android:textSize="20sp" android:textStyle="bold"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Drag to see the difference — book trusted, background-checked cleaners in a few taps."
                    android:textColor="@color/gray_text" android:textSize="13sp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/btnBookNow"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_button_purple"
                        android:gravity="center" android:text="Book Now  →" android:textColor="@color/white"
                        android:textStyle="bold" android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/btnSeePrices"
                        android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_button_purple_light"
                        android:gravity="center" android:text="See prices" android:textColor="@color/purple_dark"
                        android:textStyle="bold" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Choose a service -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="20dp"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Choose a service" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/seeAllServices" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" android:textColor="@color/teal_dark" android:textSize="12sp" android:textStyle="bold" android:padding="6dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingTop="8dp">

            <LinearLayout android:id="@+id/svcHomeCleaning" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center" android:padding="10dp" android:layout_margin="4dp"
                android:background="@drawable/bg_card_stroke">
                <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_sage" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏠" android:textSize="22sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Home Cleaning" android:textColor="@color/ink" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/svcKitchen" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center" android:padding="10dp" android:layout_margin="4dp"
                android:background="@drawable/bg_card_stroke">
                <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_peach" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🍳" android:textSize="22sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Kitchen" android:textColor="@color/ink" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/svcBathroom" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center" android:padding="10dp" android:layout_margin="4dp"
                android:background="@drawable/bg_card_stroke">
                <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_pink" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚿" android:textSize="22sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Bathroom" android:textColor="@color/ink" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="16dp" android:paddingBottom="8dp">

            <LinearLayout android:id="@+id/svcDeepCleaning" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center" android:padding="10dp" android:layout_margin="4dp"
                android:background="@drawable/bg_card_stroke">
                <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_sage" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧹" android:textSize="22sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Deep Cleaning" android:textColor="@color/ink" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/svcSofaCarpet" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center" android:padding="10dp" android:layout_margin="4dp"
                android:background="@drawable/bg_card_stroke">
                <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_peach" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛋️" android:textSize="22sp"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="Sofa &amp; Carpet" android:textColor="@color/ink" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/svcMore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center" android:padding="10dp" android:layout_margin="4dp"
                android:background="@drawable/bg_dashed_more">
                <LinearLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@color/cream" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="＋" android:textSize="22sp" android:textColor="@color/teal"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:text="More" android:textColor="@color/teal" android:textSize="11sp" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- When do you need it -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_margin="20dp" android:padding="18dp"
            android:background="@drawable/bg_card_teal_dark">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="When do you need it?" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="14dp">

                <TextView android:id="@+id/whenToday" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:background="@drawable/bg_pill_lemon" android:gravity="center"
                    android:text="Today" android:textColor="@color/ink" android:textStyle="bold" android:textSize="13sp"/>

                <TextView android:id="@+id/whenTomorrow" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                    android:layout_marginHorizontal="6dp" android:background="@drawable/bg_pill_teal" android:gravity="center"
                    android:text="Tomorrow" android:textColor="@color/white" android:textStyle="bold" android:textSize="13sp"/>

                <TextView android:id="@+id/whenSchedule" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:background="@drawable/bg_pill_teal" android:gravity="center"
                    android:text="Schedule" android:textColor="@color/white" android:textStyle="bold" android:textSize="13sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/estimateRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:background="@drawable/bg_pill_teal"
                android:layout_marginTop="14dp" android:padding="14dp" android:gravity="center_vertical">

                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="Estimated cost" android:textColor="#C9DCD4" android:textSize="13sp"/>

                <TextView android:id="@+id/estimateValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="from ৳১,৮০০" android:textColor="@color/lemon" android:textStyle="bold" android:textSize="15sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Top rated cleaners -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingHorizontal="20dp"
            android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Top-rated cleaners" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:id="@+id/seeAllCleaners" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" android:textColor="@color/teal_dark" android:textSize="12sp" android:textStyle="bold" android:padding="6dp"/>
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="16dp">

                <LinearLayout android:id="@+id/cleanerRima" android:layout_width="150dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:layout_margin="4dp"
                    android:background="@drawable/bg_card_stroke">
                    <LinearLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar_circle" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RA" android:textColor="@color/teal_dark" android:textStyle="bold" android:textSize="16sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:text="Rima Akter" android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⭐ 4.9" android:textColor="@color/lemon_dark" android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="200TK/hr" android:textColor="@color/teal" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cleanerKamal" android:layout_width="150dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:layout_margin="4dp"
                    android:background="@drawable/bg_card_stroke">
                    <LinearLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar_circle" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KH" android:textColor="@color/teal_dark" android:textStyle="bold" android:textSize="16sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:text="Kamal Hossain" android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⭐ 4.8" android:textColor="@color/lemon_dark" android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="300TK/hr" android:textColor="@color/teal" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/cleanerShirin" android:layout_width="150dp" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="14dp" android:layout_margin="4dp"
                    android:background="@drawable/bg_card_stroke">
                    <LinearLayout android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_avatar_circle" android:gravity="center">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SS" android:textColor="@color/teal_dark" android:textStyle="bold" android:textSize="16sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:text="Shirin Sultana" android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⭐ 4.7" android:textColor="@color/lemon_dark" android:textStyle="bold" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="350TK/hr" android:textColor="@color/teal" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Promo -->
        <LinearLayout
            android:id="@+id/promoBanner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_margin="20dp" android:padding="16dp"
            android:background="@drawable/bg_promo_card">

            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="20% off your first booking" android:textColor="@color/white" android:textStyle="bold" android:textSize="15sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Apply the code at checkout" android:textColor="#B7C7C0" android:textSize="12sp"/>
            </LinearLayout>

            <TextView android:id="@+id/btnPromoCode" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_lemon" android:paddingHorizontal="16dp" android:paddingVertical="10dp"
                android:text="SHINE20" android:textColor="@color/ink" android:textStyle="bold" android:textSize="13sp"/>
        </LinearLayout>

        <!-- How it works -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp" android:text="How it works" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_icon_sage" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textColor="@color/teal_dark" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select a service" android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pick the cleaning type you need" android:textColor="@color/gray_text" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_icon_sage" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textColor="@color/teal_dark" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose date &amp; time" android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today, tomorrow, or any day that suits you" android:textColor="@color/gray_text" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_icon_sage" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="@color/teal_dark" android:textStyle="bold"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Get it done" android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Relax while a vetted cleaner handles it" android:textColor="@color/gray_text" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
