<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_card_stroke" android:padding="14dp"
    android:layout_marginBottom="12dp">

    <LinearLayout android:id="@+id/bookingIconBg" android:layout_width="46dp" android:layout_height="46dp"
        android:background="@drawable/bg_icon_sage" android:gravity="center">
        <TextView android:id="@+id/bookingIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🏠" android:textSize="20sp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/bookingTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Home Cleaning" android:textColor="@color/ink" android:textStyle="bold" android:textSize="14sp"/>
        <TextView android:id="@+id/bookingSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Today · Rima Akter" android:textColor="@color/gray_text" android:textSize="12sp"/>
    </LinearLayout>

    <TextView android:id="@+id/bookingStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_lemon" android:paddingHorizontal="10dp" android:paddingVertical="5dp"
        android:text="Confirmed" android:textColor="@color/ink" android:textStyle="bold" android:textSize="11sp"/>
</LinearLayout>
